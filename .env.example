# WAF Configuration
APP_NAME=AI-WAF
APP_VERSION=1.0.0
DEBUG=false

# Upstream Backend
UPSTREAM_URL=http://localhost:8080

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Custom AI Agent (optional)
CUSTOM_AI_API_URL=
CUSTOM_AI_API_KEY=

# TLS/SSL (optional - set paths to enable HTTPS)
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=

# Redis (optional - set to enable distributed caching)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Database
USE_ASYNC_DB=true
LOG_BATCH_INTERVAL=5.0
DB_PATH=./waf.db

# Zero-Day Attack Detection
ZERO_DAY_DEV_THRESHOLD=2.0
ZERO_DAY_BASELINE_WINDOW=20

# DDoS Protection
DDOS_GLOBAL_RPS_THRESHOLD=500
DDOS_IP_FLOOD_THRESHOLD=60
DDOS_WINDOW_SECONDS=10

# Application Insights (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=
